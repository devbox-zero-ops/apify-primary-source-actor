{
  "title": "Primary-Source Data Extractor Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "source": {
      "title": "Official Data Source",
      "type": "string",
      "description": "Which zero-key official API to query.",
      "enum": ["fred", "defillama", "arxiv", "usgs_quake", "openfda", "clinicaltrials", "github_releases", "wikipedia_stats"],
      "default": "fred"
    },
    "query": {
      "title": "Series ID / Repo / Search Query",
      "type": "string",
      "description": "Examples: 'ICSA' (FRED), 'aave' (DefiLlama), 'oven-sh/bun' (GitHub), 'agentic web' (arXiv), 'aspirin' (OpenFDA).",
      "default": "ICSA"
    },
    "limit": {
      "title": "Max Items / Rows",
      "type": "integer",
      "description": "Maximum number of latest records to return.",
      "default": 10,
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": ["source", "query"]
}
